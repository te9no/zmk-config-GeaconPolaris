config ZMK_BEHAVIOR_ADAFRUIT_BLE_OTA
    bool "Adafruit nRF52 BLE OTA behavior"
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_ADAFRUIT_BLE_OTA_ENABLED
    help
      Enables a key behavior that reboots an Adafruit nRF52 bootloader into
      Nordic Secure DFU mode over Bluetooth.

if ZMK_BEHAVIOR_ADAFRUIT_BLE_OTA

config ZMK_ADAFRUIT_BLE_OTA_MAGIC
    hex "Adafruit nRF52 BLE OTA GPREGRET value"
    default 0xa8
    help
      Magic value consumed by the Adafruit nRF52 bootloader to enter BLE OTA
      mode. Do not change this unless the installed bootloader uses a custom
      value.

endif
